# PHPStan baseline.
#
# New code under api/src/Gfm should stay clean (no entries needed here).
# As legacy files (api/function, api/class) are migrated into the analysed
# paths, capture their pre-existing issues here with:
#
#   vendor/bin/phpstan analyse --generate-baseline
#
# so the build can stay green while the backlog is burned down incrementally.
parameters:
    ignoreErrors: []
