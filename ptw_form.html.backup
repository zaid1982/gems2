                        <!-- Section 4: Contractor Declaration -->
                        <div class="tab-pane fade" id="section4" role="tabpanel" aria-labelledby="section4-tab">
                            <div class="card-body">
                                <h5 class="mb-4"><strong>SECTION 4: CONTRACTOR DECLARATION</strong></h5>
                                
                                <div class="description mb-3">Contractor must confirm compliance with all safety requirements and procedures</div>
                                
                                <!-- Compliance Declarations -->
                                <div class="checklist-section">
                                    <h6>
                                        <strong>Contractor Compliance Declarations</strong>
                                        <span class="help-icon" onclick="toggleHelp('contractorDeclarations')">?</span>
                                    </h6>
                                    <div id="contractorDeclarations" class="help-example" style="display: none;">
                                        <div class="help-content">
                                            <strong>Contractor Declaration Guidelines:</strong><br>
                                            • <strong>Legal Requirement:</strong> All declarations must be truthfully answered - false declarations may result in permit denial or legal action<br>
                                            • <strong>Documentation:</strong> Ensure you have supporting documents ready (certifications, training records, insurance)<br>
                                            • <strong>Safety Compliance:</strong> Verify all team members meet stated requirements before declaring compliance<br>
                                            • <strong>Insurance Verification:</strong> Confirm coverage amounts and validity dates before submission<br><br>
                                            <strong>Common Declaration Areas:</strong><br>
                                            • Personnel training and certification status<br>
                                            • Equipment inspection and maintenance records<br>
                                            • Insurance coverage and liability limits<br>
                                            • Emergency response procedures understanding<br>
                                            • Site-specific safety requirement compliance
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th width="5%">No</th>
                                                    <th width="70%">Description</th>
                                                    <th width="12.5%">Yes</th>
                                                    <th width="12.5%">No</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td>i)</td>
                                                    <td>All assigned workers are briefed on relevant SHE Procedure and only activities stated in JHA are permitted to carry out</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration1" id="declaration1Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration1" id="declaration1No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>ii)</td>
                                                    <td>All documentation given are valid during Permit To Work validity</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration2" id="declaration2Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration2" id="declaration2No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>iii)</td>
                                                    <td>Ensure all appointed staff/workers are briefed on relevant job step and safety procedures before start work</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration3" id="declaration3Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration3" id="declaration3No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>iv)</td>
                                                    <td>GFM is not liable for any incident occurred on site if violation of the Permit To Work</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration4" id="declaration4Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration4" id="declaration4No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>v)</td>
                                                    <td>Permit to work shall be displayed at the work site all the time</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration5" id="declaration5Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration5" id="declaration5No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>vi)</td>
                                                    <td>All safety equipment has been checked and deem safe</td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration6" id="declaration6Yes" value="yes" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="radio" name="declaration6" id="declaration6No" value="no" style="transform: scale(1.5); margin: 5px; opacity: 1; visibility: visible; position: relative; z-index: 1;">
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- PPE Requirements -->
                                <div class="checklist-section mt-4">
                                    <h6>
                                        <strong>Appropriate PPE are provided/wear, please tick below:</strong>
                                        <span class="help-icon" onclick="toggleHelp('ppeRequirements')">?</span>
                                    </h6>
                                    <div id="ppeRequirements" class="help-example" style="display: none;">
                                        <div class="help-content">
                                            <strong>PPE Selection Guidelines:</strong><br>
                                            • <strong>Mandatory PPE:</strong> Required for all personnel on site - safety helmet, safety shoes, and high visibility vest are minimum requirements<br>
                                            • <strong>Task-Specific PPE:</strong> Select based on work activities - welding requires face shields, chemical work needs gloves<br>
                                            • <strong>Environmental PPE:</strong> Choose based on site conditions - respirators for dusty areas, ear protection for noisy environments<br><br>
                                            <strong>Examples by Work Type:</strong><br>
                                            • Electrical work: Safety helmet, safety shoes, insulated gloves, safety vest<br>
                                            • Welding: Safety helmet, safety shoes, welding mask, fire-resistant clothing<br>
                                            • Chemical handling: Safety helmet, chemical-resistant gloves, respirator, safety vest<br>
                                            • Height work: Safety helmet, safety harness, safety shoes, lanyard
                                        </div>
                                    </div>
                                    <div class="row">
                                        <!-- Mandatory Column -->
                                        <div class="col-md-3">
                                            <h6 class="text-primary"><strong>Mandatory</strong></h6>
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="ppeSafetyHelmet">
                                                <label class="form-check-label" for="ppeSafetyHelmet">Safety helmet</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="ppeSafetyShoes">
                                                <label class="form-check-label" for="ppeSafetyShoes">Safety shoes</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="ppeFallProtection">
                                                <label class="form-check-label" for="ppeFallProtection">Fall protection</label>
                                            </div>
                                            <div class="form-check mb-2">
                                                <input type="checkbox" class="form-check-input" id="ppeFullBodyHarness">
                                                <label class="form-check-label" for="ppeFullBodyHarness">Full Body Harness with lanyard</label>
                                            </div>
                                        </div>

                                        <!-- Respiratory Protection Column -->
