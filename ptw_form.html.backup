<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>GEMS 2.0</title>
    <!-- Browser icon -->
    <link rel="icon" type="image/png" href="img/icon/gfmicon.png" sizes="16x16">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.1/css/all.css">
    <!-- Bootstrap core CSS -->
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <!-- Material Design Bootstrap -->
    <link rel="stylesheet" href="css/mdb.min.css">
    <!-- DataTables.net -->
    <link rel="stylesheet" type="text/css" href="js/vendor/datatables/css/dataTables.bootstrap4.min.css"/>
    <!-- Stepper CSS - minified-->
    <link href="css/addons-pro/steppers.min.css" rel="stylesheet">
    <!-- Your custom styles (optional) -->
    <link href="css/style.css" rel="stylesheet">
    <!-- Your custom styles (optional) -->
    <style>
        /* Form container centering and width control */
        #divPtwPageWidth {
            max-width: 80%; /* 80% width with 10% margin on each side */
            margin: 0 auto; /* Center the container */
            padding: 0 15px; /* Add some internal padding */
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            #divPtwPageWidth {
                max-width: 95%; /* More width on smaller screens */
                margin: 0 auto;
                padding: 0 10px;
            }
        }
        
        @media (min-width: 1200px) {
            #divPtwPageWidth {
                max-width: 75%; /* Slightly narrower on large screens */
            }
        }
        
        .config-section {
            margin-bottom: 2rem;
        }
        .config-header {
            background: linear-gradient(45deg, #4285f4, #34a853);
            color: white;
            padding: 15px;
            border-radius: 8px 8px 0 0;
            margin-bottom: 0;
        }
        .config-body {
            background: #f8f9fa;
            padding: 20px;
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 8px 8px;
        }
        .form-group label {
            font-weight: 600;
            color: #495057;
        }
        .form-control:focus {
            border-color: #4285f4;
            box-shadow: 0 0 0 0.2rem rgba(66, 133, 244, 0.25);
        }
        .btn-save {
            background: linear-gradient(45deg, #34a853, #4285f4);
            border: none;
        }
        .btn-save:hover {
            background: linear-gradient(45deg, #2e8b47, #3367d6);
        }
        .description {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 5px;
        }
        .form-control.is-valid {
            border-color: #28a745;
            box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
        }
        .form-control.is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }
        .invalid-feedback {
            font-size: 0.8rem;
            color: #dc3545;
            margin-top: 5px;
        }
        .worker-section {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            background-color: #f8f9fa;
        }
        .checklist-section {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            background-color: #ffffff;
        }
        .risk-matrix {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 5px;
            margin: 1rem 0;
        }
        .risk-cell {
            padding: 10px;
            text-align: center;
            border: 1px solid #ddd;
            cursor: pointer;
        }
        .risk-low { background-color: #d4edda; }
        .risk-medium { background-color: #fff3cd; }
        .risk-high { background-color: #f8d7da; }
        .risk-critical { background-color: #dc3545; color: white; }
        
        /* Force native dropdown behavior - Override MDB select styling */
        .native-dropdown select,
        #optPtwWorkType,
        #optPtwRiskLevel {
            /* Force back to native select appearance */
            -webkit-appearance: menulist !important;
            -moz-appearance: menulist !important;
            appearance: menulist !important;
            
            /* Reset MDB transformations */
            background-image: none !important;
            background-color: #fff !important;
            border: 1px solid #ced4da !important;
            border-radius: 0.25rem !important;
            padding: 0.375rem 0.75rem !important;
            font-size: 1rem !important;
            line-height: 1.5 !important;
            color: #495057 !important;
            
            /* Ensure click events work */
            pointer-events: auto !important;
            cursor: pointer !important;
            z-index: 1 !important;
            position: relative !important;
        }
        
        .native-dropdown select:focus,
        #optPtwWorkType:focus,
        #optPtwRiskLevel:focus {
            border-color: #4285f4 !important;
            box-shadow: 0 0 0 0.2rem rgba(66, 133, 244, 0.25) !important;
            outline: none !important;
        }
        
        /* Hide any MDB-generated dropdown wrappers for native dropdowns */
        .native-dropdown .select-wrapper,
        .native-dropdown .dropdown-content,
        .native-dropdown .caret {
            display: none !important;
            visibility: hidden !important;
        }
        
        /* Prevent MDB wrapper creation */
        .native-dropdown {
            position: relative;
        }
        
        .native-dropdown select {
            width: 100% !important;
            display: block !important;
        }
        
        /* Loading overlay styles */
        #loadingOverlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }
        
        .loading-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .loading-spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #4285f4;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 0 auto 10px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Enhanced public form styling */
        .public-form-header {
            background: linear-gradient(135deg, #4285f4 0%, #34a853 100%);
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        /* Radio button styling for tables */
        .table input[type="radio"] {
            width: 18px !important;
            height: 18px !important;
            margin: 0 auto !important;
            display: block !important;
            position: relative !important;
            cursor: pointer !important;
            opacity: 1 !important;
            visibility: visible !important;
            z-index: 1 !important;
        }

        .table td.text-center {
            vertical-align: middle !important;
            padding: 10px !important;
        }

        /* Ensure radio buttons are visible and clickable */
        input[type="radio"]:not(.form-check-input) {
            -webkit-appearance: auto !important;
            -moz-appearance: auto !important;
            appearance: auto !important;
            width: 16px !important;
            height: 16px !important;
            margin: 0 !important;
            cursor: pointer !important;
            display: inline-block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* Force radio button functionality */
        .table input[type="radio"] {
            pointer-events: auto !important;
            position: relative !important;
            z-index: 999 !important;
            background: white !important;
            border: 1px solid #666 !important;
        }

        /* Override any framework radio button hiding */
        input[type="radio"] {
            -webkit-appearance: radio !important;
            -moz-appearance: radio !important;
            appearance: radio !important;
            opacity: 1 !important;
            position: relative !important;
            display: inline-block !important;
            width: auto !important;
            height: auto !important;
            margin: 3px 3px 0px 5px !important;
            cursor: pointer !important;
            outline: none !important;
        }
        
        .public-form-header h2 {
            margin: 0;
            font-weight: 600;
        }
        
        .public-form-header p {
            margin: 10px 0 0 0;
            opacity: 0.9;
        }
        
        /* Help system styling */
        .help-icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            background-color: #4285f4;
            color: white;
            border-radius: 50%;
            text-align: center;
            line-height: 18px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            margin-left: 8px;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .help-icon:hover {
            background-color: #3367d6;
            transform: scale(1.1);
        }
        
        .help-example {
            display: none;
            background-color: #e3f2fd;
            border: 1px solid #2196f3;
            border-radius: 6px;
            padding: 10px;
            margin-top: 8px;
            font-size: 0.85rem;
            color: #1565c0;
            position: relative;
        }
        
        .help-example.show {
            display: block;
            animation: fadeInDown 0.3s ease;
        }
        
        .help-example::before {
            content: '';
            position: absolute;
            top: -8px;
            left: 20px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 8px solid #2196f3;
        }
        
        .help-example strong {
            color: #0d47a1;
            display: block;
            margin-bottom: 4px;
        }
        
        .help-example .example-text {
            font-style: italic;
            color: #1976d2;
            background-color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-top: 6px;
            border-left: 3px solid #2196f3;
        }
        
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Enhanced form labels with help icons */
        .form-group label {
            font-weight: 600;
            color: #495057;
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }
        
        .label-text {
            flex: 1;
        }
        
        /* Company logo styling - Global Header */
        .global-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: transparent;
            z-index: 1000;
            padding: 15px 20px;
        }
        
        .company-logo {
            margin: 0;
        }
        
        .company-logo img {
            height: 50px;
            width: auto;
            max-width: 180px;
            transition: all 0.3s ease;
            object-fit: contain;
        }
        
        /* Adjust main content to account for fixed header */
        main {
            margin-top: 40px !important;
        }
        
        /* Tabbed interface styling */
        .nav-tabs {
            border-bottom: 3px solid #4285f4;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }
        
        .nav-tabs .nav-link {
            border: none;
            background: transparent;
            color: #495057;
            font-weight: 600;
            padding: 15px 20px;
            transition: all 0.3s ease;
        }
        
        .nav-tabs .nav-link:hover {
            border: none;
            background: rgba(66, 133, 244, 0.1);
            color: #4285f4;
        }
        
        .nav-tabs .nav-link.active {
            border: none;
            background: #4285f4;
            color: white;
            border-radius: 0;
        }
        
        .tab-content {
            background: white;
            /* Removed min-height to allow natural content height */
        }
        
        .card-footer {
            background: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 20px;
        }
        
        /* Table styling for workers */
        #workersTable {
            margin-bottom: 0;
        }
        
        #workersTable th {
            background: #4285f4;
            color: white;
            font-weight: 600;
            border: none;
        }
        
        #workersTable td {
            vertical-align: middle;
            border-color: #dee2e6;
        }
        
        #workersTable .form-control {
            border: 1px solid #ced4da;
            font-size: 0.9rem;
        }
        
        /* Hazardous activity cards */
        #coldWorkSection .card-header {
            background: linear-gradient(135deg, #007bff, #0056b3) !important;
        }
        
        #hotWorkSection .card-header {
            background: linear-gradient(135deg, #dc3545, #bd2130) !important;
        }
        
        #confinedSpaceSection .card-header {
            background: linear-gradient(135deg, #ffc107, #e0a800) !important;
        }
        
        /* Section visibility based on work type selection */
        .work-type-section {
            display: none;
        }
        
        .work-type-section.active {
            display: block;
        }
        
        /* Default: show all hazardous activity sections */
        #coldWorkSection,
        #hotWorkSection,
        #confinedSpaceSection {
            display: block;
        }
        
        /* Always show sections regardless of work type selection */
        #coldWorkSection.active,
        #hotWorkSection.active,
        #confinedSpaceSection.active {
            display: block;
        }
        
        /* Responsive logo adjustments */
        @media (max-width: 768px) {
            .global-header {
                padding: 12px 15px;
            }
            
            .company-logo img {
                height: 40px;
                max-width: 140px;
            }
            
            main {
                margin-top: 35px !important;
            }
            
            .nav-tabs .nav-link {
                padding: 12px 15px;
                font-size: 0.9rem;
            }
        }
        
        @media (max-width: 576px) {
            .global-header {
                padding: 10px 10px;
            }
            
            .company-logo img {
                height: 50px;
            }
            
            main {
                margin-top: 30px !important;
            }
            
            .nav-tabs .nav-link {
                padding: 10px 8px;
                font-size: 0.8rem;
            }
            
            .nav-tabs .nav-link i {
                display: none;
            }
        }
    </style>
    <!-- JQuery -->
    <script type="text/javascript" src="js/jquery-3.7.0.min.js"></script>
    <!--JQuery Migrate-->
    <script type="text/javascript" src="js/jquery-migrate-3.4.0.min.js"></script>
    <!-- PTW Form Classes - Load early to ensure availability -->
    <script type="text/javascript" src="js/pages/ptw_form.js"></script>
</head>
<body class="fixed-sn light-blue-skin">

<!-- Global Header with Logo -->
<header class="global-header">
    <div class="company-logo">
        <img src="img/icon/gfm-logo-transparent.png" alt="GFM Logo">
    </div>
</header>

<main style="padding: 0px; padding-top: 5.5rem;">
    <div class="container-fluid" id="divPtwPageWidth">
        <div id="mdb-lightbox-ui"></div>

        <!-- Page Title -->
        <div class="row mt-3">
            <div class="col-12">
                <h2 class="h2-responsive font-weight-bold" id="h5PtwFormTitle">
                    <i class="fas fa-shield-alt mr-3"></i>Public PTW Permit Application
                </h2>
                <p class="text-muted">Submit your Permit to Work application - No login required</p>
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle mr-2"></i>
                    <strong>Need help?</strong> Click the <span class="help-icon" style="display: inline-block; vertical-align: middle; margin: 0 5px;">?</span> icons next to field labels for examples and guidance.
                </div>
            </div>
        </div>

        <!-- Success/Error Messages -->
        <div class="row mt-4">
            <div class="col-12">
                <div id="alertSuccess" class="alert alert-success alert-dismissible fade" role="alert" style="display: none;">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span id="successMessage">PTW saved successfully!</span>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div id="alertError" class="alert alert-danger alert-dismissible fade" role="alert" style="display: none;">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    <span id="errorMessage">An error occurred while saving PTW.</span>
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- PTW Form with Tabbed Interface -->
        <section class="sectionPtwMain mb-4">
            <div class="card">
                <!-- Section Navigation Tabs -->
                <div class="card-header p-0">
                    <ul class="nav nav-tabs nav-justified" id="ptwTabs" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="section1-tab" data-toggle="tab" href="#section1" role="tab" 
                               aria-controls="section1" aria-selected="true">
                                <i class="fas fa-file-alt mr-2"></i>Section 1: Requisition
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="section2-tab" data-toggle="tab" href="#section2" role="tab" 
                               aria-controls="section2" aria-selected="false">
                                <i class="fas fa-paperclip mr-2"></i>Section 2: Supporting Documents
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="section3-tab" data-toggle="tab" href="#section3" role="tab" 
                               aria-controls="section3" aria-selected="false">
                                <i class="fas fa-exclamation-triangle mr-2"></i>Section 3: Risk Assessment
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="section4-tab" data-toggle="tab" href="#section4" role="tab" 
                               aria-controls="section4" aria-selected="false">
                                <i class="fas fa-clipboard-check mr-2"></i>Section 4: Contractor Declaration
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Tab Content -->
                <div class="tab-content" id="ptwTabContent">
                    <form id="formPtw" name="formPtw" onsubmit="return false;">
                        <input type="hidden" id="lblPtwId" value="">
                        
                        <!-- Section 1: Requisition -->
                        <div class="tab-pane fade show active" id="section1" role="tabpanel" aria-labelledby="section1-tab">
                            <div class="card-body">
                                <h5 class="mb-4"><strong>SECTION 1: REQUISITION</strong></h5>
                                
                                <div class="row">
                                    <!-- Left Column -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="txtApplicantName">
                                                <span class="label-text">Applicant Name *</span>
                                                <span class="help-icon" onclick="toggleHelp('help-applicantname')">?</span>
                                            </label>
                                            <input type="text" id="txtApplicantName" class="form-control" required placeholder="Full name of applicant">
                                            <div class="help-example" id="help-applicantname">
                                                <strong>Enter the responsible person:</strong>
                                                • Full legal name<br>
                                                • Person who will oversee the work<br>
                                                • Must be present during work execution
                                                <div class="example-text">Example: "Ahmad bin Abdullah" or "Sarah Johnson"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtContractorSupervisor">
                                                <span class="label-text">Contractor Supervisor In Charge</span>
                                                <span class="help-icon" onclick="toggleHelp('help-supervisor')">?</span>
                                            </label>
                                            <input type="text" id="txtContractorSupervisor" class="form-control" placeholder="Supervisor name">
                                            <div class="help-example" id="help-supervisor">
                                                <strong>On-site supervisor information:</strong>
                                                • Person responsible for day-to-day work supervision<br>
                                                • Must be qualified and experienced<br>
                                                • Available throughout work duration
                                                <div class="example-text">Example: "Muhammad Ali - Senior Supervisor"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtCompanyDept">
                                                <span class="label-text">Company / Department</span>
                                                <span class="help-icon" onclick="toggleHelp('help-company')">?</span>
                                            </label>
                                            <input type="text" id="txtCompanyDept" class="form-control" placeholder="Company or department name">
                                            <div class="help-example" id="help-company">
                                                <strong>Organization details:</strong>
                                                • Full company name if contractor<br>
                                                • Department name if internal<br>
                                                • Include registration details if required
                                                <div class="example-text">Example: "ABC Engineering Sdn Bhd" or "Maintenance Department"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtWorkArea">
                                                <span class="label-text">Work Area</span>
                                                <span class="help-icon" onclick="toggleHelp('help-workarea')">?</span>
                                            </label>
                                            <input type="text" id="txtWorkArea" class="form-control" placeholder="Specific work location">
                                            <div class="help-example" id="help-workarea">
                                                <strong>Be specific about location:</strong>
                                                • Building/Unit name and number<br>
                                                • Floor level or area designation<br>
                                                • Equipment tag numbers if applicable
                                                <div class="example-text">Example: "Building 3, Level 2, Pump Room - Equipment P-301A"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="optWorkType">
                                                <span class="label-text">Work Type</span>
                                                <span class="help-icon" onclick="toggleHelp('help-worktype')">?</span>
                                            </label>
                                            
                                            <!-- Hidden dropdown for JavaScript compatibility -->
                                            <select id="optPtwWorkType" class="form-control" style="display: none;">
                                                <option value="">Select Work Type</option>
                                                <option value="cold_work">Cold Work</option>
                                                <option value="hot_work">Hot Work</option>
                                                <option value="confined_space">Confined Space</option>
                                            </select>
                                            
                                            <!-- Visible checkbox interface -->
                                            <div class="row">
                                                <div class="col-4">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="chkColdWork">
                                                        <label class="form-check-label" for="chkColdWork">Cold Work</label>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="chkHotWork">
                                                        <label class="form-check-label" for="chkHotWork">Hot Work</label>
                                                    </div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" id="chkConfinedSpace">
                                                        <label class="form-check-label" for="chkConfinedSpace">Confined Space</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="help-example" id="help-worktype">
                                                <strong>Choose applicable work types:</strong>
                                                • <strong>Cold Work:</strong> Mechanical assembly, maintenance without heat<br>
                                                • <strong>Hot Work:</strong> Welding, cutting, grinding, brazing<br>
                                                • <strong>Confined Space:</strong> Work inside tanks, vessels, enclosed areas
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="optPtwRiskLevel">
                                                <span class="label-text">Risk Level</span>
                                                <span class="help-icon" onclick="toggleHelp('help-risklevel')">?</span>
                                            </label>
                                            <select id="optPtwRiskLevel" class="form-control">
                                                <option value="">Select Risk Level</option>
                                                <option value="low">Low Risk</option>
                                                <option value="medium">Medium Risk</option>
                                                <option value="high">High Risk</option>
                                                <option value="critical">Critical Risk</option>
                                            </select>
                                            <div class="help-example" id="help-risklevel">
                                                <strong>Risk assessment guidelines:</strong>
                                                • <strong>Low:</strong> Routine maintenance, minimal hazards<br>
                                                • <strong>Medium:</strong> Standard procedures with moderate risk<br>
                                                • <strong>High:</strong> Complex work requiring special precautions<br>
                                                • <strong>Critical:</strong> Extreme hazards, extensive safety measures
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtWorkDescription">
                                                <span class="label-text">Description of Work</span>
                                                <span class="help-icon" onclick="toggleHelp('help-description')">?</span>
                                            </label>
                                            <textarea id="txtWorkDescription" class="form-control" rows="4" placeholder="Detailed description of work to be performed"></textarea>
                                            <div class="help-example" id="help-description">
                                                <strong>What to include:</strong>
                                                • Specific work activities<br>
                                                • Equipment or systems involved<br>
                                                • Duration and scope of work<br>
                                                • Any special procedures required
                                                <div class="example-text">Example: "Welding repair on damaged pipeline flange connection in Processing Unit A, estimated 4 hours duration with pre-heating requirements"</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Right Column -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="txtContactNo">
                                                <span class="label-text">Contact No</span>
                                                <span class="help-icon" onclick="toggleHelp('help-contact')">?</span>
                                            </label>
                                            <input type="text" id="txtContactNo" class="form-control" placeholder="Phone number">
                                            <div class="help-example" id="help-contact">
                                                <strong>Emergency contact information:</strong>
                                                • Mobile number preferred<br>
                                                • Must be reachable during work hours<br>
                                                • Include country/area code if needed
                                                <div class="example-text">Example: "012-345-6789" or "+60123456789"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtStaffNoNRIC">
                                                <span class="label-text">Staff No / NRIC No</span>
                                                <span class="help-icon" onclick="toggleHelp('help-nric')">?</span>
                                            </label>
                                            <input type="text" id="txtStaffNoNRIC" class="form-control" placeholder="Staff number or NRIC">
                                            <div class="help-example" id="help-nric">
                                                <strong>Identification information:</strong>
                                                • Staff ID number for internal employees<br>
                                                • NRIC number for contractors<br>
                                                • Passport number for foreign workers
                                                <div class="example-text">Example: "STF001234" or "123456-12-1234"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtContactNoSupervisor">
                                                <span class="label-text">Contact No</span>
                                                <span class="help-icon" onclick="toggleHelp('help-contact-supervisor')">?</span>
                                            </label>
                                            <input type="text" id="txtContactNoSupervisor" class="form-control" placeholder="Supervisor contact">
                                            <div class="help-example" id="help-contact-supervisor">
                                                <strong>Supervisor contact details:</strong>
                                                • Direct contact number for supervisor<br>
                                                • Must be available during work hours<br>
                                                • For emergency coordination
                                                <div class="example-text">Example: "012-987-6543"</div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtIdentificationNo">
                                                <span class="label-text">Identification No</span>
                                                <span class="help-icon" onclick="toggleHelp('help-identification')">?</span>
                                            </label>
                                            <input type="text" id="txtIdentificationNo" class="form-control" placeholder="ID number">
                                            <div class="help-example" id="help-identification">
                                                <strong>Additional identification:</strong>
                                                • Contractor registration number<br>
                                                • Professional certification number<br>
                                                • Company registration number
                                                <div class="example-text">Example: "PKK-12345-A" or "CE-098765"</div>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-6">
                                                <div class="form-group">
                                                    <label for="txtDurationFrom">
                                                        <span class="label-text">Duration of Work - From</span>
                                                        <span class="help-icon" onclick="toggleHelp('help-duration')">?</span>
                                                    </label>
                                                    <input type="date" id="txtDurationFrom" class="form-control">
                                                    <div class="help-example" id="help-duration">
                                                        <strong>Work schedule:</strong>
                                                        • Start date cannot be in the past<br>
                                                        • Allow time for approvals<br>
                                                        • Consider preparation time needed
                                                        <div class="example-text">Tip: Permits need 24-48 hours for processing</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="form-group">
                                                    <label for="txtDurationTo">
                                                        <span class="label-text">To</span>
                                                    </label>
                                                    <input type="date" id="txtDurationTo" class="form-control">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label for="txtLevel">
                                                <span class="label-text">Level</span>
                                                <span class="help-icon" onclick="toggleHelp('help-level')">?</span>
                                            </label>
                                            <input type="text" id="txtLevel" class="form-control" placeholder="Floor/Level">
                                            <div class="help-example" id="help-level">
                                                <strong>Location level information:</strong>
                                                • Floor number or level designation<br>
                                                • Height above ground if applicable<br>
                                                • Reference landmarks
                                                <div class="example-text">Example: "Level 3", "Ground Floor", "Basement B1"</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- List of Workers Section -->
                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6><strong>List of Workers</strong></h6>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnAddWorker">
                                            <i class="fas fa-plus"></i> Add Worker
                                        </button>
                                    </div>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="workersTable">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th width="5%">No</th>
                                                    <th width="30%">Name</th>
                                                    <th width="25%">Designation</th>
                                                    <th width="25%">Identification No</th>
                                                    <th width="10%">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Workers will be added dynamically -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Hazardous Activities Section -->
                                <div class="mt-4">
                                    <h6><strong>Hazardous Activities</strong></h6>
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle"></i>
                                        <strong>Complete the relevant sections below</strong> based on your work type selections above.
                                    </div>

                                    <!-- Cold Work Section -->
                                    <div class="card mb-3" id="coldWorkSection">
                                        <div class="card-header bg-primary text-white">
                                            <h6 class="mb-0"><strong>COLD WORK</strong></h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6><strong>CONDITIONS TO BE IMPLEMENTED BY SUPERVISOR / CONTRACTOR SUPERVISOR</strong></h6>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldElectricalWork">
                                                        <label class="form-check-label" for="coldElectricalWork">Electrical Work</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldVisualInspection">
                                                        <label class="form-check-label" for="coldVisualInspection">Visual Inspection</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldLockOutTagOut">
                                                        <label class="form-check-label" for="coldLockOutTagOut">Lock Out & Tagged Out</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldFireExtinguisher">
                                                        <label class="form-check-label" for="coldFireExtinguisher">Fire Extinguisher</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldMainSupplyCutOff">
                                                        <label class="form-check-label" for="coldMainSupplyCutOff">Main Supply Cut Off</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldWorkingAtHeight">
                                                        <label class="form-check-label" for="coldWorkingAtHeight">Working at Height</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldExcavationWork">
                                                        <label class="form-check-label" for="coldExcavationWork">Excavation Work</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldLiftingWork">
                                                        <label class="form-check-label" for="coldLiftingWork">Lifting Work</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="coldOthers">
                                                        <label class="form-check-label" for="coldOthers">Others</label>
                                                    </div>
                                                    <input type="text" id="coldOthersText" class="form-control mt-2" placeholder="Please specify others...">
                                                </div>

                                                <div class="col-md-6">
                                                    <h6><strong>Special Precautions</strong></h6>
                                                    <textarea id="coldSpecialPrecautions" class="form-control" rows="6" 
                                                              placeholder="Describe any special precautions required for cold work..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Hot Work Section -->
                                    <div class="card mb-3" id="hotWorkSection">
                                        <div class="card-header bg-danger text-white">
                                            <h6 class="mb-0"><strong>HOT WORK</strong></h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6><strong>Controls Required</strong></h6>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotGasMonitoring">
                                                        <label class="form-check-label" for="hotGasMonitoring">Gas monitoring</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotFirewatch">
                                                        <label class="form-check-label" for="hotFirewatch">Firewatch</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotRemoveFlammables">
                                                        <label class="form-check-label" for="hotRemoveFlammables">Remove flammable materials</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotFireExtinguisher">
                                                        <label class="form-check-label" for="hotFireExtinguisher">Fire extinguisher available</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotVentilation">
                                                        <label class="form-check-label" for="hotVentilation">Adequate ventilation</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="hotBarricades">
                                                        <label class="form-check-label" for="hotBarricades">Barricades in place</label>
                                                    </div>
                                                    
                                                    <div class="mt-3">
                                                        <h6><strong>Type of Hot Work</strong></h6>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotWelding">
                                                            <label class="form-check-label" for="hotWelding">Welding</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotCutting">
                                                            <label class="form-check-label" for="hotCutting">Cutting</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotGrinding">
                                                            <label class="form-check-label" for="hotGrinding">Grinding</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotBrazing">
                                                            <label class="form-check-label" for="hotBrazing">Brazing</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotSoldering">
                                                            <label class="form-check-label" for="hotSoldering">Soldering</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="hotOthers">
                                                            <label class="form-check-label" for="hotOthers">Others</label>
                                                        </div>
                                                        <input type="text" id="hotOthersText" class="form-control mt-2" placeholder="Please specify others...">
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <h6><strong>Special Precautions</strong></h6>
                                                    <textarea id="hotSpecialPrecautions" class="form-control" rows="6" 
                                                              placeholder="Describe special precautions for hot work..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Confined Space Section -->
                                    <div class="card mb-3" id="confinedSpaceSection">
                                        <div class="card-header bg-warning text-dark">
                                            <h6 class="mb-0"><strong>CONFINED SPACE</strong></h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <h6><strong>Entry Condition</strong></h6>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csRespiratoryAtmosphere">
                                                        <label class="form-check-label" for="csRespiratoryAtmosphere">Respiratory Atmosphere</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csNonRespiratoryAtmosphere">
                                                        <label class="form-check-label" for="csNonRespiratoryAtmosphere">Non-Respiratory Atmosphere</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csGasMonitoring">
                                                        <label class="form-check-label" for="csGasMonitoring">Gas Monitoring Required</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csVentilation">
                                                        <label class="form-check-label" for="csVentilation">Mechanical Ventilation</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csEntryAttendant">
                                                        <label class="form-check-label" for="csEntryAttendant">Entry Attendant Present</label>
                                                    </div>
                                                    <div class="form-check mb-2">
                                                        <input type="checkbox" class="form-check-input" id="csRescueEquipment">
                                                        <label class="form-check-label" for="csRescueEquipment">Rescue Equipment Available</label>
                                                    </div>
                                                    
                                                    <div class="mt-3">
                                                        <h6><strong>Communication Methods</strong></h6>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="csRadio">
                                                            <label class="form-check-label" for="csRadio">Radio Communication</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="csVisualSignals">
                                                            <label class="form-check-label" for="csVisualSignals">Visual Signals</label>
                                                        </div>
                                                        <div class="form-check mb-2">
                                                            <input type="checkbox" class="form-check-input" id="csRopeTugging">
                                                            <label class="form-check-label" for="csRopeTugging">Rope Tugging System</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <h6><strong>Special Precautions</strong></h6>
                                                    <textarea id="csSpecialPrecautions" class="form-control" rows="6" 
                                                              placeholder="Describe special precautions for confined space entry..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Section 2: Supporting Documents -->
                        <div class="tab-pane fade" id="section2" role="tabpanel" aria-labelledby="section2-tab">
                            <div class="card-body">
                                <h5 class="mb-4"><strong>SECTION 2: SUPPORTING DOCUMENTS</strong></h5>
                                
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle mr-2"></i>
                                    <strong>Document Requirements:</strong> Please ensure all relevant supporting documents are prepared before work commencement.
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label><strong>Risk Assessment Documents</strong></label>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docRiskAssessment">
                                                <label class="form-check-label" for="docRiskAssessment">Job Hazard Analysis (JHA) completed</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docMethodStatement">
                                                <label class="form-check-label" for="docMethodStatement">Method Statement prepared</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docSafetyPlan">
                                                <label class="form-check-label" for="docSafetyPlan">Safety Plan available</label>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label><strong>Personnel Certifications</strong></label>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docTrainingRecords">
                                                <label class="form-check-label" for="docTrainingRecords">Training records verified</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docCompetencyCerts">
                                                <label class="form-check-label" for="docCompetencyCerts">Competency certificates available</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docMedicalFitness">
                                                <label class="form-check-label" for="docMedicalFitness">Medical fitness certificates</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label><strong>Equipment Documentation</strong></label>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docEquipmentCerts">
                                                <label class="form-check-label" for="docEquipmentCerts">Equipment certificates available</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docInspectionReports">
                                                <label class="form-check-label" for="docInspectionReports">Pre-use inspection reports</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docMaintenanceRecords">
                                                <label class="form-check-label" for="docMaintenanceRecords">Maintenance records current</label>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label><strong>Insurance & Legal</strong></label>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docInsuranceCert">
                                                <label class="form-check-label" for="docInsuranceCert">Insurance certificate valid</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docContractorLicense">
                                                <label class="form-check-label" for="docContractorLicense">Contractor license current</label>
                                            </div>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="docEnvironmentalPermit">
                                                <label class="form-check-label" for="docEnvironmentalPermit">Environmental permits (if required)</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group mt-4">
                                    <label for="txtDocumentRemarks"><strong>Additional Document Notes</strong></label>
                                    <textarea id="txtDocumentRemarks" class="form-control" rows="3" 
                                              placeholder="Specify any additional documents or special requirements..."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Risk Assessment & Safety Measures -->
                        <div class="tab-pane fade" id="section3" role="tabpanel" aria-labelledby="section3-tab">
                            <div class="card-body">
                                <h5 class="mb-4"><strong>SECTION 3: RISK ASSESSMENT & SAFETY MEASURES</strong></h5>
                                
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i>
                                    <strong>Risk Assessment:</strong> Complete the risk assessment and identify additional safety measures for your work.
                                </div>

                                <!-- Dynamic Checklist Container for JavaScript compatibility -->
                                <div id="specificChecklistContainer" style="display: none;">
                                    <!-- This container is used by the JavaScript for dynamic checklist loading -->
                                </div>

                                <!-- Risk Assessment -->
                                <div class="card mb-4">
                                    <div class="card-header bg-info text-white">
                                        <h6 class="mb-0"><strong>RISK ASSESSMENT</strong></h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtIdentifiedHazards"><strong>Identified Hazards</strong></label>
                                                    <textarea id="txtIdentifiedHazards" class="form-control" rows="4" 
                                                              placeholder="List all potential hazards associated with this work..."></textarea>
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label for="txtRiskLevelAssessment"><strong>Overall Risk Level Assessment</strong></label>
                                                    <select id="txtRiskLevelAssessment" class="form-control">
                                                        <option value="">Select Risk Level</option>
                                                        <option value="low">Low Risk</option>
                                                        <option value="medium">Medium Risk</option>
                                                        <option value="high">High Risk</option>
                                                        <option value="critical">Critical Risk</option>
                                                    </select>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label for="txtControlMeasures"><strong>Control Measures</strong></label>
                                                    <textarea id="txtControlMeasures" class="form-control" rows="4" 
                                                              placeholder="Describe control measures to mitigate identified risks..."></textarea>
                                                </div>
                                                
                                                <div class="form-group">
                                                    <label for="txtEmergencyProcedures"><strong>Emergency Procedures</strong></label>
                                                    <textarea id="txtEmergencyProcedures" class="form-control" rows="4" 
                                                              placeholder="Describe emergency procedures and contacts..."></textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Additional Safety Requirements -->
                                <div class="card mb-4">
                                    <div class="card-header bg-success text-white">
                                        <h6 class="mb-0"><strong>ADDITIONAL SAFETY REQUIREMENTS</strong></h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6><strong>Environmental Considerations</strong></h6>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" class="form-check-input" id="envNoiseControl">
                                                    <label class="form-check-label" for="envNoiseControl">Noise control measures required</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" class="form-check-input" id="envDustControl">
                                                    <label class="form-check-label" for="envDustControl">Dust control measures required</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" class="form-check-input" id="envWasteManagement">
                                                    <label class="form-check-label" for="envWasteManagement">Special waste management required</label>
                                                </div>
                                                <div class="form-check mb-2">
                                                    <input type="checkbox" class="form-check-input" id="envWaterProtection">
                                                    <label class="form-check-label" for="envWaterProtection">Water/drainage protection required</label>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <h6><strong>Traffic & Access Control</strong></h6>
