            </div>
        </section>
    </div>

    <div class="includeHtml" id="h-modal_change_password"></div>
    <div class="includeHtml" id="h-modal_pdf"></div>
</main>

<!-- SCRIPTS -->
<script type="text/javascript">
    $('.includeHtml').each(function () {
        const divId = $(this).attr('id');
        $('#'+divId).load('html/'+divId.substr(2)+'.html?' + new Date().valueOf());
    });
</script>

<!-- Bootstrap tooltips -->
<script type="text/javascript" src="js/popper.min.js"></script>
<!-- Bootstrap core JavaScript -->
<script type="text/javascript" src="js/bootstrap.js"></script>
<!-- MDB core JavaScript -->
<script type="text/javascript" src="js/mdb.js"></script>
<!-- Crypto JS -->
<script type="text/javascript" src="js/addons/crypto.js"></script>
<!-- DataTables.net -->
<script type="text/javascript" src="js/vendor/datatables/js/jquery.dataTables.min.js"></script>
<script type="text/javascript" src="js/vendor/datatables/js/dataTables.bootstrap4.min.js"></script>
<!-- Moment JavaScript -->
<script type="text/javascript" src="js/addons/moment.min.js"></script>
<!-- Toastr -->
<script type="text/javascript" src="js/modules/toastr.js"></script>

<!--Custom scripts-->
<script type="text/javascript">
    let ptwFormClass_; // Main PTW form class instance

    // Initialize radio buttons for contractor declarations
    function initializeRadioButtons() {
        // Get all radio buttons in the contractor declaration table
        const radioButtons = document.querySelectorAll('input[type="radio"][name^="declaration"]');
        
        radioButtons.forEach(function(radio) {
            // Remove any existing event listeners
            radio.onclick = null;
            radio.onchange = null;
            
            // Force radio button properties
            radio.style.display = 'inline-block';
            radio.style.opacity = '1';
            radio.style.visibility = 'visible';
            radio.style.pointerEvents = 'auto';
            radio.style.position = 'relative';
            radio.style.zIndex = '999';
            
            // Add click event listener
            radio.addEventListener('click', function(e) {
                e.stopPropagation();
                console.log('Radio button clicked:', this.name, this.value);
                
                // Manually handle radio button selection
                const name = this.name;
                const otherRadios = document.querySelectorAll(`input[type="radio"][name="${name}"]`);
                otherRadios.forEach(function(otherRadio) {
                    otherRadio.checked = false;
                });
                this.checked = true;
                
                // Trigger change event
                this.dispatchEvent(new Event('change', { bubbles: true }));
            });
            
            // Add change event listener for debugging
            radio.addEventListener('change', function(e) {
                console.log('Radio button changed:', this.name, this.value, 'checked:', this.checked);
            });
        });
        
        console.log('Initialized', radioButtons.length, 'radio buttons');
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Initialize tab navigation
        initializeTabNavigation();
        
        // Initialize work type handlers
        initializeWorkTypeHandlers();
        
        // Initialize radio buttons for contractor declarations
        initializeRadioButtons();
        
        // Simple loading indicator
        showLoadingIndicator();
        
        // Set default dates for testing
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        const todayStr = today.toISOString().split('T')[0];
        const tomorrowStr = tomorrow.toISOString().split('T')[0];
        
        // Use the new field IDs from Section 1
        const fromDateField = document.getElementById('txtDurationFrom');
        const toDateField = document.getElementById('txtDurationTo');
        
        if (fromDateField) fromDateField.value = todayStr;
        if (toDateField) toDateField.value = tomorrowStr;
        
        setTimeout(function () {
            try {
                // Initialize PTW form class with public configuration
                ptwFormClass_ = new PtwForm();
                
                // Set public mode configuration
                ptwFormClass_.setPublicMode(true);
                
                // Add null checks for required elements before initialization
                const requiredElements = ['optPtwWorkType', 'specificChecklistContainer'];
                const missingElements = requiredElements.filter(id => !document.getElementById(id));
                
                if (missingElements.length > 0) {
                    console.warn('Missing required elements:', missingElements);
                    // Initialize anyway but with error handling
                }
                
                ptwFormClass_.init();
                
                // Prevent form submission
                $('#formPtw').on('submit', function(e) {
                    e.preventDefault();
                    console.log('Form submission prevented');
                    return false;
                });
                
                // Make globally accessible for debugging
                window.ptwFormClass_ = ptwFormClass_;
                
            } catch (e) {
                showError('Failed to initialize form: ' + e.message);
                console.error('PTW Form initialization error:', e);
            }
            hideLoadingIndicator();
        }, 300);
    });

    // Tab navigation functionality
    function initializeTabNavigation() {
        const tabs = ['section1', 'section2', 'section3', 'section4'];
        let currentTabIndex = 0;
        
        const btnNext = document.getElementById('btnNext');
        const btnPrevious = document.getElementById('btnPrevious');
        const btnSubmit = document.getElementById('btnSubmitApproval');
        
        // Initialize navigation buttons
        updateNavigationButtons();
        
        // Next button functionality
        if (btnNext) {
            btnNext.addEventListener('click', function() {
                if (currentTabIndex < tabs.length - 1) {
                    currentTabIndex++;
                    showTab(tabs[currentTabIndex]);
                    updateNavigationButtons();
                }
            });
        }
        
        // Previous button functionality
        if (btnPrevious) {
            btnPrevious.addEventListener('click', function() {
                if (currentTabIndex > 0) {
                    currentTabIndex--;
                    showTab(tabs[currentTabIndex]);
                    updateNavigationButtons();
                }
            });
        }
        
        // Tab click functionality
        tabs.forEach((tabId, index) => {
            const tabLink = document.getElementById(tabId + '-tab');
            if (tabLink) {
                tabLink.addEventListener('click', function() {
                    currentTabIndex = index;
                    updateNavigationButtons();
                });
            }
        });
        
        function showTab(tabId) {
            // Use Bootstrap's tab methods
            const tabTrigger = document.getElementById(tabId + '-tab');
            if (tabTrigger) {
                $(tabTrigger).tab('show');
            }
        }
        
        function updateNavigationButtons() {
            // Show/hide previous button
            if (btnPrevious) {
                btnPrevious.style.display = currentTabIndex > 0 ? 'inline-block' : 'none';
            }
            
            // Show/hide next button and submit button
            if (currentTabIndex === tabs.length - 1) {
                // Last tab - show submit button, hide next
                if (btnNext) btnNext.style.display = 'none';
                if (btnSubmit) btnSubmit.style.display = 'inline-block';
            } else {
                // Not last tab - show next button, hide submit
                if (btnNext) btnNext.style.display = 'inline-block';
                if (btnSubmit) btnSubmit.style.display = 'none';
            }
        }
        
        // Add event listener for the Add Worker button
        const btnAddWorker = document.getElementById('btnAddWorker');
        if (btnAddWorker) {
            btnAddWorker.addEventListener('click', addWorkerToTable);
        }
    }

    // Work type checkbox handlers - Simplified version (no hiding/showing)
    function initializeWorkTypeHandlers() {
        const coldWorkCheckbox = document.getElementById('chkColdWork');
        const hotWorkCheckbox = document.getElementById('chkHotWork');
        const confinedSpaceCheckbox = document.getElementById('chkConfinedSpace');
        const workTypeDropdown = document.getElementById('optPtwWorkType');

        function updateWorkTypeDropdown() {
            // Update hidden dropdown to sync with checkboxes for JavaScript compatibility
            if (workTypeDropdown) {
                if (coldWorkCheckbox && coldWorkCheckbox.checked) {
                    workTypeDropdown.value = 'cold_work';
                } else if (hotWorkCheckbox && hotWorkCheckbox.checked) {
                    workTypeDropdown.value = 'hot_work';
                } else if (confinedSpaceCheckbox && confinedSpaceCheckbox.checked) {
                    workTypeDropdown.value = 'confined_space';
                } else {
                    workTypeDropdown.value = '';
                }
            }
        }

        // Add event listeners to sync with hidden dropdown
        if (coldWorkCheckbox) {
            coldWorkCheckbox.addEventListener('change', updateWorkTypeDropdown);
        }

        if (hotWorkCheckbox) {
            hotWorkCheckbox.addEventListener('change', updateWorkTypeDropdown);
        }

        if (confinedSpaceCheckbox) {
            confinedSpaceCheckbox.addEventListener('change', updateWorkTypeDropdown);
        }

        // Initialize dropdown
        updateWorkTypeDropdown();
    }

    // Worker management for the new table format
    function addWorkerToTable() {
        const tbody = document.querySelector('#workersTable tbody');
        if (!tbody) return;
        
        const rowCount = tbody.children.length + 1;
        const row = document.createElement('tr');
        
        row.innerHTML = `
            <td>${rowCount}</td>
            <td><input type="text" class="form-control worker-name" placeholder="Worker name" required></td>
            <td><input type="text" class="form-control worker-designation" placeholder="Designation/Role"></td>
            <td><input type="text" class="form-control worker-id" placeholder="NRIC or ID number"></td>
            <td>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeWorkerRow(this)">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        
        tbody.appendChild(row);
        console.log('Worker added to table, total workers:', tbody.children.length);
    }
    
    function removeWorkerRow(button) {
        const row = button.closest('tr');
        const tbody = row.parentNode;
        row.remove();
        
        // Renumber the workers
        Array.from(tbody.children).forEach((row, index) => {
            row.children[0].textContent = index + 1;
        });
        
        console.log('Worker removed, total workers:', tbody.children.length);
    }
    
    // Make functions globally accessible
    window.addWorkerToTable = addWorkerToTable;
    window.removeWorkerRow = removeWorkerRow;

    // Flag to prevent multiple dropdown protection runs
    let dropdownProtectionInitialized = false;

    // Function to prevent MDB from transforming specific dropdowns
    function preventMDBDropdownTransformation() {
        const protectedSelects = ['optPtwWorkType', 'optPtwRiskLevel'];
        
        protectedSelects.forEach(selectId => {
            const selectElement = document.getElementById(selectId);
            if (selectElement) {
                // Remove any MDB classes that might have been added
                selectElement.classList.remove('mdb-select', 'md-form', 'browser-default');
                
                // Ensure it has the standard Bootstrap class
                selectElement.classList.add('form-control');
                
                // Remove any MDB-generated wrapper elements
                const wrapper = selectElement.parentNode.querySelector('.select-wrapper');
                if (wrapper) {
                    wrapper.style.display = 'none';
                }
                
                // Prevent MDB from re-initializing this select
                selectElement.setAttribute('data-mdb-select-init', 'false');
                selectElement.setAttribute('data-select-init', 'false');
                
                // Force native appearance
                selectElement.style.webkitAppearance = 'menulist';
                selectElement.style.mozAppearance = 'menulist';
                selectElement.style.appearance = 'menulist';
            }
        });
    }

    // Run protection only once after DOM is ready
    function initializeDropdownProtection() {
        if (dropdownProtectionInitialized) {
            return; // Already initialized, don't run again
        }
        
        dropdownProtectionInitialized = true;
        preventMDBDropdownTransformation();
        
        // Run once more after a short delay to catch any late MDB initialization
        setTimeout(preventMDBDropdownTransformation, 500);
    }

    // Alert functions for public form
    function showSuccess(message) {
        document.getElementById('successMessage').textContent = message;
        const alertElement = document.getElementById('alertSuccess');
        alertElement.style.display = 'block';
        alertElement.classList.add('show');
        
        // Hide after 5 seconds
        setTimeout(() => {
            alertElement.classList.remove('show');
            setTimeout(() => {
                alertElement.style.display = 'none';
            }, 150);
        }, 5000);
    }

    function showError(message) {
        document.getElementById('errorMessage').textContent = message;
        const alertElement = document.getElementById('alertError');
        alertElement.style.display = 'block';
        alertElement.classList.add('show');
        
        // Hide after 8 seconds
        setTimeout(() => {
            alertElement.classList.remove('show');
            setTimeout(() => {
                alertElement.style.display = 'none';
            }, 150);
        }, 8000);
    }

    // Loading indicator functions to replace ShowLoader/HideLoader
    function showLoadingIndicator() {
        // Create overlay if it doesn't exist
        let overlay = document.getElementById('loadingOverlay');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'loadingOverlay';
            overlay.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 9999;
            `;
            
            const spinner = document.createElement('div');
            spinner.innerHTML = `
                <div style="
                    background: white;
                    padding: 20px;
                    border-radius: 8px;
                    text-align: center;
                    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
                ">
                    <div style="
                        border: 4px solid #f3f3f3;
                        border-top: 4px solid #4285f4;
                        border-radius: 50%;
                        width: 40px;
                        height: 40px;
                        animation: spin 1s linear infinite;
                        margin: 0 auto 10px;
                    "></div>
                    <div style="color: #333; font-weight: 500;">Loading...</div>
                </div>
                <style>
                    @keyframes spin {
                        0% { transform: rotate(0deg); }
                        100% { transform: rotate(360deg); }
                    }
                </style>
            `;
            overlay.appendChild(spinner);
            document.body.appendChild(overlay);
        }
        overlay.style.display = 'flex';
    }

    function hideLoadingIndicator() {
        const overlay = document.getElementById('loadingOverlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    // Global functions for PTW form class compatibility
    window.ShowLoader = showLoadingIndicator;
    window.HideLoader = hideLoadingIndicator;
    window.showSuccess = showSuccess;
    window.showError = showError;

    // Help system functionality
    function toggleHelp(helpId) {
        const helpElement = document.getElementById(helpId);
        if (helpElement) {
            // Hide all other help examples first
            document.querySelectorAll('.help-example.show').forEach(el => {
                if (el.id !== helpId) {
                    el.classList.remove('show');
                }
            });
            
            // Toggle the clicked help example
            helpElement.classList.toggle('show');
            
            // Smooth scroll to help if it's being shown
            if (helpElement.classList.contains('show')) {
                setTimeout(() => {
                    helpElement.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'nearest' 
                    });
                }, 100);
            }
        }
    }

    // Close help examples when clicking outside
    document.addEventListener('click', function(event) {
        if (!event.target.closest('.help-icon') && !event.target.closest('.help-example')) {
            document.querySelectorAll('.help-example.show').forEach(el => {
                el.classList.remove('show');
            });
        }
    });

    // Scripts now loaded in head section to ensure availability before instantiation
    // All dependencies removed for public form - no authentication required

</script>

</body>
</html>
