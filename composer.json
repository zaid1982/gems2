{
    "name": "globalfm/gfm-gems",
    "description": "GFM GEMS facility management backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^1.11 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "Gfm\\": "api/src/Gfm/"
        },
        "classmap": [
            "api/src/JWT.php",
            "api/src/BeforeValidException.php",
            "api/src/ExpiredException.php",
            "api/src/SignatureInvalidException.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gfm\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
