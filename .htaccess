RewriteEngine On

RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

RewriteRule ^p_drawing_records/?$ drawing_records.html
RewriteRule ^p_drawing_deleted/?$ drawing_deleted.html
RewriteRule ^p_inventory/?$ inventory.html
RewriteRule ^p_purchase_request/?$ purchase_request.html
RewriteRule ^p_supplier_management/?$ supplier_management.html
RewriteRule ^p_item_management/?$ item_management.html
RewriteRule ^p_item_type_management/?$ item_type_management.html
RewriteRule ^p_store_management/?$ store_management.html
RewriteRule ^p_kpi_ppns/?$ kpi_ppns.html
RewriteRule ^p_utility/?$ utility.html
RewriteRule ^p_attendance/?$ attendance.html
RewriteRule ^p_attendance_config/?$ attendance_config.html
RewriteRule ^p_gamification/?$ gamification.html

RewriteRule ^drawing/?$ api/drawing.php
RewriteRule ^drawing/(.+)/?$ api/drawing.php
RewriteRule ^m_inventory/?$ api/m_inventory.php
RewriteRule ^m_inventory/(.+)/?$ api/m_inventory.php
RewriteRule ^pr/?$ api/pr.php
RewriteRule ^pr/(.+)/?$ api/pr.php
RewriteRule ^item_type/?$ api/item_type.php
RewriteRule ^item_type/(.+)/?$ api/item_type.php
RewriteRule ^store/?$ api/store.php
RewriteRule ^store/(.+)/?$ api/store.php
RewriteRule ^item/?$ api/item.php
RewriteRule ^item/(.+)/?$ api/item.php
RewriteRule ^item_image/?$ api/item_image.php
RewriteRule ^item_image/(.+)/?$ api/item_image.php
RewriteRule ^part/?$ api/part.php
RewriteRule ^part/(.+)/?$ api/part.php
RewriteRule ^part_sub/?$ api/part_sub.php
RewriteRule ^part_sub/(.+)/?$ api/part_sub.php
RewriteRule ^wo_request/?$ api/wo_request.php
RewriteRule ^wo_request/(.+)/?$ api/wo_request.php
RewriteRule ^wo_parts/?$ api/wo_parts.php
RewriteRule ^wo_parts/(.+)/?$ api/wo_parts.php
RewriteRule ^do/?$ api/do.php
RewriteRule ^do/(.+)/?$ api/do.php
RewriteRule ^do_item/?$ api/do_item.php
RewriteRule ^do_item/(.+)/?$ api/do_item.php
RewriteRule ^user_signature/?$ api/user_signature.php
RewriteRule ^user_signature/(.+)/?$ api/user_signature.php
RewriteRule ^utility/?$ api/utility.php
RewriteRule ^utility/(.+)/?$ api/utility.php
RewriteRule ^utility_meter/?$ api/utility_meter.php
RewriteRule ^utility_meter/(.+)/?$ api/utility_meter.php
RewriteRule ^kpi/?$ api/kpi.php
RewriteRule ^kpi/(.+)/?$ api/kpi.php
RewriteRule ^att_group/?$ api/att_group.php
RewriteRule ^att_group/(.+)/?$ api/att_group.php
RewriteRule ^att_participant/?$ api/att_participant.php
RewriteRule ^att_participant/(.+)/?$ api/att_participant.php
RewriteRule ^gamification/?$ api/gamification.php
RewriteRule ^gamification/(.+)/?$ api/gamification.php
RewriteRule ^wo_v2/?$ api/wo_v2.php
RewriteRule ^wo_v2/(.+)/?$ api/wo_v2.php
RewriteRule ^ppm_v2/?$ api/ppm_v2.php
RewriteRule ^ppm_v2/(.+)/?$ api/ppm_v2.php
RewriteRule ^wo_task_assist/?$ api/wo_task_assist.php
RewriteRule ^wo_task_assist/(.+)/?$ api/wo_task_assist.php
RewriteRule ^ppm_task_assist/?$ api/ppm_task_assist.php
RewriteRule ^ppm_task_assist/(.+)/?$ api/ppm_task_assist.php
RewriteRule ^user_profile/?$ api/user_profile.php
RewriteRule ^user_profile/(.+)/?$ api/user_profile.php