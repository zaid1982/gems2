.idea/

# Environment / secrets (never commit real values; commit .env.example instead)
.env
.env.*
!.env.example
api/library/config.ini

# Dev tooling caches
.phpunit.cache/
.php-cs-fixer.cache
api/upload/
api/pdf/ppm/
api/pdf/checklist/
api/pdf/wo/
api/pdf/wr/
api/pdf/mrf/
globalfm.p12
9880959c-7403-4c07-9d2a-4af4ee4c1abb.txt
**/.DS_Store

# Composer dependencies - installed via 'composer install'
vendor/
# NOTE: composer.lock SHOULD be committed for an application so installs are
# reproducible (CI relies on it). It is intentionally NOT ignored.

# Ignore all uploaded files stored outside api/
upload/
*.code-workspace

# Development & debugging tools (never deploy to production)
developer/
generated_sql/

# Backup files
*.backup

# Test scripts & data at root level
test_*.sh
test_*.php
test_*.csv

# Postman collections
*.postman_collection.json

# Stray debug / scratch artifacts (see docs/REPO_HYGIENE.md for untracking existing ones)
response.json
*.log
*.tmp

# OS / editor cruft
.vscode/
*.swp
Thumbs.db
