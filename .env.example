# =============================================================================
# GFM GEMS environment configuration (TEMPLATE)
#
# Copy this file to ".env" and fill in real values. The .env file is git-ignored
# and must NEVER be committed. Values here are resolved by Gfm\Support\Config and
# take precedence over api/library/config.ini, which is kept only as a fallback
# for existing deployments.
#
# Resolution order for every setting:
#   1. real environment variable / .env
#   2. api/library/config.ini
#   3. built-in default
# =============================================================================

# --- Application -------------------------------------------------------------
# production | staging | development
APP_ENV=production
# true enables full error reporting + display_errors (use only in dev/staging)
APP_DEBUG=false
# Public base URL of the API, e.g. //gems.example.com/api/
APP_URL=

# --- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gfm_jkr
DB_USER=root
DB_PASS=

# Absolute path for debug/error logs (subfolders /debug and /error are created)
LOG_DIR=

# --- JWT / Authentication ----------------------------------------------------
# REQUIRED in production. Generate a strong random secret, e.g.:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# If left empty the app falls back to the legacy key and logs a warning.
JWT_SECRET=
# Access-token lifetime in seconds (86400 = 24h). Keep aligned with the mobile app.
JWT_TTL=86400
# Validation leeway in seconds. Keep generous (86400) during rollout so tokens
# issued by the previous implementation keep validating, then tighten to e.g. 60
# once all clients have re-authenticated with the new tokens.
JWT_LEEWAY=86400
# Refresh-token lifetime in seconds (2592000 = 30 days).
JWT_REFRESH_TTL=2592000

# --- Maintenance tools (maintenance/ directory) ------------------------------
# Required to unlock operator tools via maintenance/dashboard.html (X-Api-Key).
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
MAINTENANCE_API_KEY=

# --- Mail / SMTP (Exchange Online) -------------------------------------------
MAIL_FROM=gems-support@example.com
MAIL_ENVELOPE_FROM=gems-support@example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# STARTTLS | TLS | PLAIN
SMTP_SECURITY=STARTTLS
SMTP_USER=gems-support@example.com
SMTP_PASS=
SMTP_TIMEOUT=30
